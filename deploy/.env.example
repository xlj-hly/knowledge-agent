# 已有 PostgreSQL；密码中的特殊字符须 URL 编码。
# 容器内 localhost 是自身。Docker Desktop 访问宿主机使用 host.docker.internal。
DATABASE_URL='postgres://agent:replace_me@host.docker.internal:5432/agent?sslmode=disable'
PLATFORM_HOSTS=platform.localhost

# 只发布 Web 端口；生产由外层 HTTPS 网关访问此端口。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
IMAGE_TAG=local

# 现有私有 S3 桶，兼容 MinIO / AWS S3 等服务；不由应用创建桶。
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://host.docker.internal:9002
S3_REGION=us-east-1
S3_BUCKET=agent
S3_ACCESS_KEY_ID=replace_with_bucket_scoped_access_key
S3_SECRET_ACCESS_KEY=replace_with_bucket_scoped_secret_key
S3_USE_PATH_STYLE=true
