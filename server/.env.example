# 本地复制为 .env 后填写实际值；启动时自动加载，系统环境变量优先。勿提交真实密码。
DATABASE_URL=postgres://admin:replace_me@localhost:5432/agent?sslmode=disable
LISTEN_ADDR=:8080
ALLOWED_ORIGINS=
# 平台管理域名，与企业域名区分；代理须保留 Host。
PLATFORM_HOSTS=platform.localhost
# 对象存储由配置选择，业务代码不依赖服务商。
# 本地文件模式：STORAGE_PROVIDER=filesystem，缺省目录 .local/objects。
STORAGE_PROVIDER=s3
STORAGE_FILESYSTEM_ROOT=.local/objects
# MinIO 或其他 S3 兼容服务；标准 AWS S3 可留空 endpoint。
S3_ENDPOINT=http://127.0.0.1:9002
S3_REGION=us-east-1
S3_BUCKET=agent
S3_ACCESS_KEY_ID=replace_with_bucket_scoped_access_key
S3_SECRET_ACCESS_KEY=replace_with_bucket_scoped_secret_key
S3_USE_PATH_STYLE=true
# 仅执行 go run ./cmd/api bootstrap 时读取，创建成功后移除。
BOOTSTRAP_USERNAME=platform.admin
BOOTSTRAP_PASSWORD=replace_with_a_unique_password
